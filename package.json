{
  "name": "@meridian/design-system",
  "version": "1.4.1",
  "description": "MERIDIAN Design System v1.4.1 — Geist Sans/Serif/Mono with optical kerning & block rhythm, Single-Ink + Soft Chromatic, PaperGrain, HalfTone, Plotter SVG.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run registry && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "registry": "node scripts/build-registry.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./paper-grain": "./src/paper-grain.ts",
    "./page-enter": "./src/page-enter.ts",
    "./plotter-svg": "./src/plotter-svg.ts",
    "./atelier-engine": "./src/atelier-engine.ts",
    "./timeline": "./src/timeline.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css",
    "./components.css": "./src/components.css"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "keywords": [
    "design-system",
    "typescript",
    "react-native",
    "css",
    "svg",
    "plotter",
    "watercolor",
    "generative-art",
    "editorial-design"
  ],
  "files": [
    "src",
    "assets",
    "registry",
    "public/r",
    "DESIGN_SYSTEM.md",
    "index.html",
    "preview.html",
    "gann.html",
    "historia.html",
    "manifesto.html",
    "components.html",
    "components.json",
    "README.md"
  ],
  "dependencies": {
    "@paper-design/shaders": "^0.0.82",
    "geist": "^1.9.2"
  }
}
